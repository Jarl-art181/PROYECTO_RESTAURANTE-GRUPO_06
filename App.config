<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <connectionStrings>
        <!-- Application Name permite identificar las sesiones de la app en SQL Server. -->
        <add name="AL_ESTILO_PIURA"
             connectionString="Server=LAPTOP-GH63852S\SQLEXPRESS;Database=AL_ESTILO_PIURA;Integrated Security=True;Application Name=AlEstiloPiurano;Connect Timeout=15;"
             providerName="System.Data.SqlClient" />
    </connectionStrings>
    <appSettings>
        <!-- Borrado definitivo de empleados, productos e insumos SIN historial
             (condiciones en EliminacionSegura.cs). Habilitado con autorización del
             Administrador del sistema el 07/11/2026. Con "false" solo se puede desactivar. -->
        <add key="PermitirEliminacionDefinitiva" value="true" />
        <!-- IGV: CONFIGURACIÓN ACADÉMICA (no es validación tributaria SUNAT). Precios con IGV
             incluido: IGV = Importe x tasa / (100 + tasa). Los pedidos cobrados antes de
             TasaIgvAcademicaDesde se reimprimen con la tasa anterior (18 %). -->
        <add key="TasaIgvAcademica" value="10" />
        <add key="TasaIgvAcademicaDesde" value="2026-11-09 20:00" />
    </appSettings>
</configuration>
